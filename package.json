{
  "name": "react-skeletonix",
  "version": "1.1.0",
  "description": "Zero-config React skeleton loader. Wrap any component and react-skeletonix turns its real layout into an animated loading placeholder: text, images, buttons and nested components included. Shimmer, pulse, wave and blink animations.",
  "type": "module",
  "main": "./dist/react-skeletonix.cjs",
  "module": "./dist/react-skeletonix.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/react-skeletonix.umd.js",
  "jsdelivr": "./dist/react-skeletonix.umd.js",
  "style": "./dist/style.css",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/react-skeletonix.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/react-skeletonix.cjs"
      }
    },
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "css": "node scripts/build-css.mjs",
    "build": "npm run css && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node scripts/test-browser.mjs",
    "check": "npm run lint && npm run typecheck && npm run test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "keywords": [
    "react",
    "skeleton",
    "skeleton-loader",
    "skeleton-screen",
    "skeleton-ui",
    "react-skeleton",
    "react-skeleton-loader",
    "loading",
    "loading-states",
    "loader",
    "placeholder",
    "content-placeholder",
    "content-loader",
    "shimmer",
    "pulse",
    "auto-generated",
    "zero-config",
    "typescript",
    "nextjs",
    "skeletonix"
  ],
  "author": {
    "name": "Amit Kumar",
    "url": "https://www.linkedin.com/in/amitkumar9297/"
  },
  "maintainers": [
    {
      "name": "devpranali",
      "url": "https://github.com/devpranali"
    }
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devpranali/react-skeletonix.git"
  },
  "homepage": "https://doc.react-skeletonix.devpranali.com/",
  "bugs": {
    "url": "https://github.com/devpranali/react-skeletonix/issues"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  }
}
